#!/system/bin/sh

# Mihomo configuration: /data/adb/box/mihomo/config.yaml

# Keep root for transparent sockets and net_admin as the primary GID.
CORE_USER_GROUP="root:net_admin"

# Proxy mode: tproxy or tun.
PROXY_MODE="tproxy"

# Match tproxy-port in the Mihomo configuration.
TPROXY_PORT="1536"

# Match dns.listen; use 0.0.0.0:<port> for hotspot DNS redirection.
DNS_PORT="1053"

# Use one reserved routing bit (2^21-2^28) and a priority below 10000.
TPROXY_MARK="268435456" # 0x10000000
TPROXY_TABLE="2025"
TPROXY_RULE_PREF="2025"
# Match the network prefix of dns.fake-ip-range.
FAKE_IP_RANGE="198.18.0.0/16"

# Hotspot proxy: 1 to enable, 0 to disable.
PROXY_HOTSPOT=1
# Match tun.device when using TUN mode.
tun_device="mihomo"
# Hotspot interfaces, separated by spaces. Confirm names with ip -o link.
HOTSPOT_INTERFACE="wlan1"
