#!/system/bin/sh

# Mihomo config: /data/adb/box/mihomo/config.yaml

# Mihomo running user:group
CORE_USER_GROUP="root:net_admin"

# Proxy mode: tproxy / tun
PROXY_MODE="tproxy"

# Should match tproxy-port in your Mihomo config
TPROXY_PORT="1536"

# TProxy policy routing mark, table and rule preference.
# TPROXY_RULE_PREF must stay below 10000 so the rule is evaluated before the
# ones installed by Android netd.
TPROXY_MARK="20"
TPROXY_TABLE="2025"
TPROXY_RULE_PREF="2025"

# Should match dns.fake-ip-range in your Mihomo config
# Leave empty when the core does not run in fake-ip mode
# ICMP to this range is answered locally so pinging works
FAKE_IP_RANGE="198.18.0.0/16"

# Proxy hotspot clients through TProxy or TUN
PROXY_HOTSPOT=1
# TUN interface name for hotspot forwarding support
# Should match tun.device in your Mihomo config
tun_device="mihomo"
# Separate multiple interface names with spaces
# Enable the hotspot once and run `ip -o link` to find the actual name
HOTSPOT_INTERFACE="wlan1 ap0"
