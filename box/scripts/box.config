#!/system/bin/sh

# Mihomo config: /data/adb/box/mihomo/config.yaml

# Mihomo runs as root for IP_TRANSPARENT. xt_owner matches the socket's primary
# GID; supplementary net_admin membership alone does not bypass interception.
CORE_USER_GROUP="root:net_admin"

# Proxy mode: tproxy / tun
PROXY_MODE="tproxy"

# Should match tproxy-port in your Mihomo config
TPROXY_PORT="1536"

# Should match the port in dns.listen in your Mihomo config
# dns must listen on 0.0.0.0 so hotspot requests
# redirected to the AP interface can reach it
DNS_PORT="1053"

# TProxy routing: use one reserved mark bit (2^21-2^28).
# Keep rule preference below 10000 to precede Android netd.
TPROXY_MARK="268435456" # 0x10000000
TPROXY_TABLE="2025"
TPROXY_RULE_PREF="2025"

# Proxy hotspot clients
PROXY_HOTSPOT=1
# TUN interface name for hotspot forwarding support
# Should match tun.device in your Mihomo config
tun_device="mihomo"
# Separate multiple interface names with spaces
# Enable the hotspot once and run `ip -o link` to find the actual name
HOTSPOT_INTERFACE="wlan1 ap0"
