#!/system/bin/sh

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

readonly IPV6_CONF_DIR="/proc/sys/net/ipv6/conf"
readonly BLOCK_RULE_PREF="1"
readonly IPV6_BLOCK_CHAIN="MBOX_IPV6_BLOCK"
readonly MONITOR_STATE="/data/adb/box/run/ipv6_monitor.runtime"
readonly MONITOR_FIFO="/data/adb/box/run/ipv6_monitor.fifo"

monitor_start=""
monitor_ip_pid=""
monitor_ip_start=""

log() {
  local level="$1"
  local message="$2"
  local timestamp

  export TZ=Asia/Shanghai
  timestamp="$(date +"%Y-%m-%d %H:%M:%S")"
  printf "%s [%s]: %s\n" "${timestamp}" "${level}" "${message}" >&2
}

is_uint() {
  case "$1" in
  '' | *[!0-9]*) return 1 ;;
  *) return 0 ;;
  esac
}

has_block_rule() {
  ip -6 rule show 2>/dev/null | busybox awk -v pref="${BLOCK_RULE_PREF}:" '
    $1 == pref {
      if (NF == 4 && $2 == "from" && $3 == "all" && $4 == "unreachable") found = 1
      else conflict = 1
    }
    END { exit !(found && !conflict) }
  '
}

ensure_block_rule() {
  local rules

  has_block_rule && return 0
  rules=$(ip -6 rule show) || return 1
  while printf '%s\n' "${rules}" | busybox awk -v pref="${BLOCK_RULE_PREF}:" '
    $1 == pref { found = 1 }
    END { exit !found }
  '; do
    log Warn "IPv6 rule preference ${BLOCK_RULE_PREF} is occupied; replacing it with unreachable."
    if ! ip -6 rule del pref "${BLOCK_RULE_PREF}"; then
      log Error "cannot replace IPv6 rule preference ${BLOCK_RULE_PREF}."
      return 1
    fi
    rules=$(ip -6 rule show) || return 1
  done
  ip -6 rule add unreachable pref "${BLOCK_RULE_PREF}" || return 1
  has_block_rule || return 1
  log Info "IPv6 external routing is blocked."
}

ipv6_filter() {
  local hook

  ip6tables -w 100 -t filter -N "${IPV6_BLOCK_CHAIN}" >/dev/null 2>&1 ||
    ip6tables -w 100 -t filter -L "${IPV6_BLOCK_CHAIN}" -n >/dev/null 2>&1 || return 1
  ip6tables -w 100 -t filter -C "${IPV6_BLOCK_CHAIN}" -j DROP >/dev/null 2>&1 ||
    ip6tables -w 100 -t filter -A "${IPV6_BLOCK_CHAIN}" -j DROP || return 1
  # Packet filters cover all interfaces except lo, including IMS.
  for hook in OUTPUT FORWARD; do
    ip6tables -w 100 -t filter -C "${hook}" ! -o lo -j "${IPV6_BLOCK_CHAIN}" >/dev/null 2>&1 && continue
    ip6tables -w 100 -t filter -I "${hook}" 1 ! -o lo -j "${IPV6_BLOCK_CHAIN}" || return 1
  done
}

has_global_ipv4() {
  ip -o -4 addr show dev "$1" scope global 2>/dev/null |
    busybox awk 'NR == 1 { found = 1 } END { exit !found }'
}

has_global_ipv6() {
  ip -o -6 addr show dev "$1" scope global 2>/dev/null |
    busybox awk 'NR == 1 { found = 1 } END { exit !found }'
}

is_ipv6_only_ims_interface() {
  local interface="$1"

  case "${interface}" in
  rmnet*) ;;
  *) return 1 ;;
  esac

  has_global_ipv6 "${interface}" && ! has_global_ipv4 "${interface}"
}

is_unclassified_rmnet_interface() {
  case "$1" in
  rmnet*) ! has_global_ipv4 "$1" && ! has_global_ipv6 "$1" ;;
  *) return 1 ;;
  esac
}

list_ipv6_interfaces() {
  local path

  for path in "${IPV6_CONF_DIR}"/*; do
    [ -d "${path}" ] || continue
    case "${path##*/}" in
    all | default) continue ;;
    esac
    printf "%s\n" "${path##*/}"
  done
}

sync_ipv6_interfaces() {
  local quiet="$1"
  local interface
  local setting
  local failed=0
  local changed=0
  local excluded=0

  for interface in $(list_ipv6_interfaces); do
    if is_ipv6_only_ims_interface "${interface}"; then
      [ "${quiet}" = "quiet" ] || log Info "keeping IPv6 enabled on IMS interface ${interface}."
      excluded=$((excluded + 1))
      continue
    fi
    # Leave unaddressed rmnet interfaces enabled until IMS can be identified.
    if is_unclassified_rmnet_interface "${interface}"; then
      continue
    fi

    setting="${IPV6_CONF_DIR}/${interface}/disable_ipv6"
    if [ ! -r "${setting}" ] || [ ! -w "${setting}" ]; then
      [ "${quiet}" = "quiet" ] || \
        log Error "cannot manage IPv6 on interface ${interface}."
      failed=1
      continue
    fi

    if [ "$(cat "${setting}" 2>/dev/null)" = "1" ]; then
      continue
    fi

    if ! printf "1\n" 2>/dev/null >"${setting}"; then
      # netd may remove the interface during this write.
      [ -e "${setting}" ] || continue
      [ "${quiet}" = "quiet" ] || \
        log Error "cannot disable IPv6 on interface ${interface}."
      failed=1
      continue
    fi

    changed=$((changed + 1))
  done

  if [ "${failed}" -ne 0 ]; then
    [ "${quiet}" = "quiet" ] || \
      log Error "IPv6 could not be disabled on every non-IMS interface."
    return 1
  fi

  [ "${quiet}" = "quiet" ] ||
    log Info "IPv6 is disabled per interface; changed ${changed}, excluded ${excluded} IPv6-only IMS interface(s)."
}

sync_ipv6_after_event() {
  local drained=0

  # Coalesce bounded netd event bursts before rescanning interfaces.
  while [ "${drained}" -lt 32 ] && IFS= read -r -t 1 _; do
    drained=$((drained + 1))
  done

  sync_ipv6_interfaces quiet && return 0
  sleep 1
  sync_ipv6_interfaces quiet && return 0

  log Warn "IPv6 interface update is still in progress; waiting for the next network event."
  return 1
}

read_monitor_value() {
  local key="$1"

  [ -r "${MONITOR_STATE}" ] || return 1
  busybox awk -F= -v key="${key}" '$1 == key { print $2; exit }' "${MONITOR_STATE}"
}

process_start_time() {
  busybox awk '{ print $22; exit }' "/proc/$1/stat" 2>/dev/null
}

# Match the start time as well as the PID to avoid PID reuse.
process_matches() {
  local pid="$1"
  local expected_start="$2"
  local actual_start

  is_uint "${pid}" && is_uint "${expected_start}" || return 1
  kill -0 "${pid}" >/dev/null 2>&1 || return 1
  actual_start=$(process_start_time "${pid}")
  [ "${actual_start}" = "${expected_start}" ]
}

monitor_is_running() {
  monitor_wrapper_is_running &&
    process_matches "$(read_monitor_value IP_PID)" "$(read_monitor_value IP_START_TIME)"
}

monitor_wrapper_is_running() {
  process_matches "$(read_monitor_value PID)" "$(read_monitor_value START_TIME)"
}

cleanup_stale_monitor() {
  local ip_pid
  local ip_start

  monitor_wrapper_is_running && return 1
  ip_pid=$(read_monitor_value IP_PID)
  ip_start=$(read_monitor_value IP_START_TIME)
  if process_matches "${ip_pid}" "${ip_start}"; then
    kill "${ip_pid}" >/dev/null 2>&1 || true
  fi
  rm -f "${MONITOR_STATE}" "${MONITOR_FIFO}" >/dev/null 2>&1 || true
}

monitor_cleanup() {
  local state_pid

  trap - EXIT HUP INT TERM
  if process_matches "${monitor_ip_pid}" "${monitor_ip_start}"; then
    kill "${monitor_ip_pid}" >/dev/null 2>&1 || true
    wait "${monitor_ip_pid}" 2>/dev/null || true
  fi
  state_pid=$(read_monitor_value PID)
  if [ "${state_pid}" = "$$" ]; then
    rm -f "${MONITOR_STATE}" "${MONITOR_FIFO}" >/dev/null 2>&1 || true
  fi
}

# Publish process identities together so readers never see partial state.
publish_monitor_state() {
  local state_tmp="${MONITOR_STATE}.tmp.$$"

  if ! {
    printf "PID=%s\n" "$$"
    printf "START_TIME=%s\n" "${monitor_start}"
    printf "IP_PID=%s\n" "${monitor_ip_pid}"
    printf "IP_START_TIME=%s\n" "${monitor_ip_start}"
  } >"${state_tmp}" || ! mv -f "${state_tmp}" "${MONITOR_STATE}"; then
    rm -f "${state_tmp}" >/dev/null 2>&1 || true
    return 1
  fi
}

monitor_interfaces() {
  if monitor_wrapper_is_running; then
    log Error "IPv6 network monitoring is already running."
    return 1
  fi
  cleanup_stale_monitor || true
  rm -f "${MONITOR_FIFO}" >/dev/null 2>&1 || true
  busybox mkfifo "${MONITOR_FIFO}" || return 1
  monitor_start=$(process_start_time "$$")
  if ! is_uint "${monitor_start}"; then
    rm -f "${MONITOR_FIFO}" >/dev/null 2>&1 || true
    return 1
  fi

  trap 'monitor_cleanup' EXIT
  trap 'exit 0' HUP INT TERM
  while :; do
    ip monitor link address >"${MONITOR_FIFO}" 2>>/data/adb/box/run/run.log &
    monitor_ip_pid=$!
    monitor_ip_start=$(process_start_time "${monitor_ip_pid}")
    if ! process_matches "${monitor_ip_pid}" "${monitor_ip_start}"; then
      kill "${monitor_ip_pid}" >/dev/null 2>&1 || true
      log Warn "IPv6 network event listener exited during startup; retrying."
      sleep 1
      continue
    fi

    if ! publish_monitor_state; then
      log Error "cannot publish the IPv6 network monitor state."
      return 1
    fi

    while IFS= read -r _; do
      sync_ipv6_after_event || true
    done <"${MONITOR_FIFO}"
    wait "${monitor_ip_pid}" 2>/dev/null || true
    log Warn "IPv6 network event listener exited; restarting."
    sleep 1
  done
}

start_monitor() {
  local attempts=0
  local expected_pid

  if monitor_wrapper_is_running; then
    while [ "${attempts}" -lt 5 ]; do
      monitor_is_running && return 0
      attempts=$((attempts + 1))
      sleep 1
    done
    log Error "IPv6 network monitor is running without an active event listener."
    return 1
  fi

  cleanup_stale_monitor || true
  busybox nohup "$0" monitor >/dev/null 2>>/data/adb/box/run/run.log &
  expected_pid=$!

  while [ "${attempts}" -lt 5 ]; do
    if monitor_is_running && [ "$(read_monitor_value PID)" = "${expected_pid}" ]; then
      return 0
    fi
    kill -0 "${expected_pid}" >/dev/null 2>&1 || break
    attempts=$((attempts + 1))
    sleep 1
  done

  kill "${expected_pid}" >/dev/null 2>&1 || true
  cleanup_stale_monitor || true
  log Error "cannot start the IPv6 network monitor."
  return 1
}

start_ipv6() {
  ipv6_filter || return 1
  ensure_block_rule || return 1
  sync_ipv6_interfaces "" || return 1
  start_monitor || return 1

  # Rescan for changes that occurred before the listener was ready.
  sync_ipv6_interfaces quiet || true
}

case "$1" in
start)
  start_ipv6
  ;;
monitor)
  monitor_interfaces
  ;;
*)
  log Error "usage: $0 {start|monitor}"
  exit 2
  ;;
esac
