#!/system/bin/sh

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

scripts_dir=$(dirname "$0")

CONFIG_FILE="${scripts_dir}/box.config"
[ -f "${CONFIG_FILE}" ] && . "${CONFIG_FILE}"

bin_name="mihomo"
box_path="/data/adb/box"
run_path="${box_path}/run"
core_dir="${box_path}/${bin_name}"
bin_path="${box_path}/bin/${bin_name}"
pid_file="${run_path}/${bin_name}.pid"

CORE_USER_GROUP="${CORE_USER_GROUP:-root:net_admin}"
tun_device="${tun_device:-Mihomo}"

mkdir -p "${run_path}"
mkdir -p "${core_dir}"

have_cmd() {
    command -v "$1" > /dev/null 2>&1
}

get_pid() {
    local pids
    local pid

    if have_cmd pidof; then
        pids=$(pidof "${bin_name}" 2> /dev/null || true)
        pid=$(echo "${pids}" | awk '{print $1}')
        [ -n "${pid}" ] && printf "%s" "${pid}" && return 0
    fi

    if have_cmd ps; then
        pid=$(ps 2> /dev/null | awk '$NF=="'"${bin_name}"'"{print $2; exit}')
        [ -n "${pid}" ] && printf "%s" "${pid}" && return 0
    fi

    return 1
}

log() {
    local level="$1"
    local message="$2"
    local timestamp
    local color_code

    export TZ=Asia/Shanghai
    timestamp="$(date +"%Y-%m-%d %H:%M:%S")"

    case "$level" in
        Debug) color_code="\033[0;36m" ;;
        Info) color_code="\033[1;32m" ;;
        Warn) color_code="\033[1;33m" ;;
        Error) color_code="\033[1;31m" ;;
        *)
            level="Unknown"
            color_code="\033[0m"
            ;;
    esac

    if [ -t 2 ]; then
        printf "%b\n" "${color_code}${timestamp} [${level}]: ${message}\033[0m" >&2
    else
        printf "%s\n" "${timestamp} [${level}]: ${message}" >&2
    fi
}

check_permission() {
    local resolved_path
    if [ -f "${bin_path}" ]; then
        chown "${CORE_USER_GROUP}" "${bin_path}" 2> /dev/null || true
        chmod 0700 "${bin_path}" 2> /dev/null || true
        chown -R "${CORE_USER_GROUP}" "${run_path}" "${core_dir}" 2> /dev/null || true
        return 0
    fi

    resolved_path=$(command -v "${bin_name}" 2> /dev/null || true)
    if [ -n "${resolved_path}" ] && echo "${resolved_path}" | grep -q "^/system/bin/"; then
        bin_path="${resolved_path}"
        chown "${CORE_USER_GROUP}" "${bin_path}" 2> /dev/null || true
        chmod 0755 "${bin_path}" 2> /dev/null || true
        chown -R "${CORE_USER_GROUP}" "${run_path}" "${core_dir}" 2> /dev/null || true
        return 0
    fi

    return 1
}

start_bin() {
    ulimit -SHn 1000000

    if "${bin_path}" -t -d "${core_dir}" > "${run_path}/check.log" 2>&1; then
        log Info "starting ${bin_name} service."

        nohup busybox setuidgid "${CORE_USER_GROUP}" \
            "${bin_path}" -d "${core_dir}" \
            > /dev/null 2> "${run_path}/error_${bin_name}.log" &
        echo -n $! > "${pid_file}"
        return 0
    fi

    log Error "configuration check failed, please check ${run_path}/check.log."
    return 1
}

wait_bin_listen() {
    local wait_count=0
    local bin_pid

    while [ "${wait_count}" -lt 100 ]; do
        bin_pid=$(get_pid 2> /dev/null || true)
        [ -n "${bin_pid}" ] || return 1

        probe_tun_device && return 0

        sleep 1
        wait_count=$((wait_count + 1))
    done

    return 1
}

display_bin_status() {
    local bin_pid
    if bin_pid=$(get_pid 2> /dev/null); then
        local etime=""
        if have_cmd busybox; then
            etime=$(busybox ps -o comm,etime 2> /dev/null | awk '$1=="'"${bin_name}"'"{print $2; exit}')
        fi
        log Info "${bin_name} service is running. ( PID: ${bin_pid} )"
        log Info "${bin_name} memory usage: $(grep -w VmRSS /proc/${bin_pid}/status 2> /dev/null | awk '{print $2$3}')"
        log Info "${bin_name} cpu usage: $(/system/bin/ps -eo %CPU,NAME 2> /dev/null | grep ${bin_name} | awk '{print $1\"%\"}' || dumpsys cpuinfo | grep ${bin_name} | awk '{print $1}')"
        [ -n "${etime}" ] && log Info "${bin_name} running time: ${etime}"
        echo -n "${bin_pid}" > "${pid_file}"
        return 0
    fi

    log Warn "${bin_name} service is stopped."
    return 1
}

start_service() {
    if check_permission; then
        if start_bin && wait_bin_listen; then
            log Info "${bin_name} service is running. ( PID: $(cat "${pid_file}") )"
            return 0
        fi

        if get_pid > /dev/null 2>&1; then
            log Warn "${bin_name} service is running but may not listening."
            return 0
        fi

        log Error "start ${bin_name} service failed, please check ${run_path}/error_${bin_name}.log."
        rm -f "${pid_file}" > /dev/null 2>&1 || true
        return 1
    fi

    log Error "missing ${bin_name} core, please download and place it in ${box_path}/bin/."
    return 2
}

stop_service() {
    local bin_pid
    bin_pid=$(get_pid 2> /dev/null || true)
    if [ -n "${bin_pid}" ]; then
        echo -n "${bin_pid}" > "${pid_file}"
        display_bin_status
        log Warn "stopping ${bin_name} service."
        kill "${bin_pid}" 2> /dev/null || killall "${bin_name}" 2> /dev/null || true
        sleep 1
        display_bin_status
    fi
    rm -f "${pid_file}" > /dev/null 2>&1 || true
}

probe_tun_device() {
    if command -v ifconfig > /dev/null 2>&1; then
        ifconfig 2> /dev/null | grep -q "${tun_device}" && return 0
    fi
    ip link show "${tun_device}" > /dev/null 2>&1
}

tun_ip_rules() {
    ip rule "$1" from all iif "${tun_device}" lookup main suppress_prefixlength 0 pref 8000
    ip rule "$1" lookup main pref 9005
}

tun_forward_iptables_rules() {
    command -v iptables > /dev/null 2>&1 || return 1

    iptables -w 100 "$1" FORWARD -o "${tun_device}" -j ACCEPT
    iptables -w 100 "$1" FORWARD -i "${tun_device}" -j ACCEPT

    if command -v ip6tables > /dev/null 2>&1; then
        ip6tables -w 100 "$1" FORWARD -o "${tun_device}" -j ACCEPT
        ip6tables -w 100 "$1" FORWARD -i "${tun_device}" -j ACCEPT
    fi
}

tun_forward_enable() {
    tun_forward_disable
    sleep 1

    echo 1 > /proc/sys/net/ipv4/ip_forward
    echo 2 > /proc/sys/net/ipv4/conf/default/rp_filter
    echo 2 > /proc/sys/net/ipv4/conf/all/rp_filter

    if probe_tun_device; then
        tun_forward_iptables_rules "-I" && tun_ip_rules "add" && log Info "tun hotspot support is enabled."
    fi
    return 0
}

tun_forward_disable() {
    tun_ip_rules "del" >> /dev/null 2>&1
    tun_forward_iptables_rules "-D" >> /dev/null 2>&1
    log Warn "tun hotspot support is disabled."
}

case "$1" in
    start)
        display_bin_status || start_service
        [ $? = "0" ] && tun_forward_enable
        ;;
    stop)
        stop_service
        tun_forward_disable
        ;;
    restart)
        stop_service
        sleep 2
        start_service
        ;;
    status)
        display_bin_status
        ;;
    *)
        log Error "$0 $1 usage: $0 {start|stop|restart|status}"
        ;;
esac
