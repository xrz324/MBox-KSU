#!/system/bin/sh

# Prepare network rules, start Mihomo and wait for its proxy endpoint.

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

scripts_dir=$(dirname "$0")

CONFIG_FILE="${scripts_dir}/box.config"
[ -f "${CONFIG_FILE}" ] && . "${CONFIG_FILE}"

bin_name="mihomo"
box_path="/data/adb/box"
run_path="${box_path}/run"
core_dir="${box_path}/${bin_name}"
bin_path="${box_path}/bin/${bin_name}"
pid_file="${run_path}/${bin_name}.pid"
tproxy_path="${scripts_dir}/box.tproxy"
dns_path="${scripts_dir}/box.dns"

CORE_USER_GROUP="${CORE_USER_GROUP:-root:net_admin}"
PROXY_HOTSPOT="${PROXY_HOTSPOT:-1}"
PROXY_MODE="${PROXY_MODE:-tproxy}"
TPROXY_PORT="${TPROXY_PORT:-1536}"
DNS_PORT="${DNS_PORT:-1053}"
tun_device="${tun_device:-mihomo}"

mkdir -p "${run_path}"
mkdir -p "${core_dir}"

get_pid() {
  local pids
  local pid

  pids=$(busybox pidof "${bin_name}" 2>/dev/null || true)
  pid=$(printf "%s\n" "${pids}" | busybox awk '{print $1}')
  [ -n "${pid}" ] && printf "%s" "${pid}" && return 0

  return 1
}

log() {
  local level="$1"
  local message="$2"
  local timestamp
  local color_code

  export TZ=Asia/Shanghai
  timestamp="$(date +"%Y-%m-%d %H:%M:%S")"

  case "$level" in
  Debug) color_code="\033[0;36m" ;;
  Info) color_code="\033[1;32m" ;;
  Warn) color_code="\033[1;33m" ;;
  Error) color_code="\033[1;31m" ;;
  *)
    level="Unknown"
    color_code="\033[0m"
    ;;
  esac

  if [ -t 2 ]; then
    printf "%b\n" "${color_code}${timestamp} [${level}]: ${message}\033[0m" >&2
  else
    printf "%s\n" "${timestamp} [${level}]: ${message}" >&2
  fi
}

check_permission() {
  if [ -f "${bin_path}" ]; then
    chown "${CORE_USER_GROUP}" "${bin_path}" 2>/dev/null || true
    chmod 0700 "${bin_path}" 2>/dev/null || true
    chown -R "${CORE_USER_GROUP}" "${run_path}" "${core_dir}" 2>/dev/null || true
    return 0
  fi

  return 1
}

start_bin() {
  ulimit -SHn 1000000

  if busybox setuidgid "${CORE_USER_GROUP}" "${bin_path}" -t -d "${core_dir}" >"${run_path}/check.log" 2>&1; then
    log Info "starting ${bin_name} service..."

    busybox nohup busybox setuidgid "${CORE_USER_GROUP}" \
      "${bin_path}" -d "${core_dir}" \
      >/dev/null 2>"${run_path}/error_${bin_name}.log" &
    echo -n $! >"${pid_file}"
    return 0
  fi

  log Error "configuration check failed, check ${run_path}/check.log for errors."
  return 1
}

probe_port() {
  local protocol="$1"
  local port="$2"
  local option

  case "${protocol}" in
  tcp) option="-lnt" ;;
  udp) option="-lnu" ;;
  *) return 1 ;;
  esac

  ss -H "${option}" 2>/dev/null | busybox awk -v port="${port}" '
    $4 ~ (":" port "$") { found = 1 }
    END { exit !found }
  '
}

probe_tproxy_ports() {
  probe_port tcp "${TPROXY_PORT}" &&
    probe_port udp "${TPROXY_PORT}" &&
    probe_port tcp "${DNS_PORT}" &&
    probe_port udp "${DNS_PORT}"
}

probe_tun_device() {
  ip link show "${tun_device}" >/dev/null 2>&1
}

proxy_is_ready() {
  case "${PROXY_MODE}" in
  tproxy) probe_tproxy_ports ;;
  tun) probe_tun_device ;;
  *) return 1 ;;
  esac
}

wait_bin_ready() {
  local attempts=0

  while [ "${attempts}" -lt 100 ]; do
    get_pid >/dev/null 2>&1 || return 1
    proxy_is_ready && return 0
    attempts=$((attempts + 1))
    sleep 1
  done

  return 1
}

start_service() {
  local bin_pid

  if check_permission; then
    if start_bin && wait_bin_ready && bin_pid=$(get_pid 2>/dev/null); then
      printf "%s" "${bin_pid}" >"${pid_file}"
      log Info "${bin_name} service is running. ( PID: ${bin_pid} )"
      return 0
    fi

    log Error "start ${bin_name} service failed, please check ${run_path}/error_${bin_name}.log."
    stop_service
    return 1
  fi

  log Error "missing ${bin_name} core, please download and place it under ${box_path}/bin/."
  return 2
}

stop_service() {
  local bin_pid
  bin_pid=$(get_pid 2>/dev/null || true)
  if [ -n "${bin_pid}" ]; then
    echo -n "${bin_pid}" >"${pid_file}"
    log Warn "stopping ${bin_name} service..."
    kill "${bin_pid}" 2>/dev/null || killall "${bin_name}" 2>/dev/null || true
    sleep 1
  fi
  rm -f "${pid_file}" >/dev/null 2>&1 || true
}

tun_ip_rules() {
  ip rule "$1" from all iif "${tun_device}" lookup main suppress_prefixlength 0 pref 8000
  ip rule "$1" lookup main pref 9005
}

tun_forward_iptables_rules() {
  iptables -w 100 "$1" FORWARD -o "${tun_device}" -j ACCEPT
  iptables -w 100 "$1" FORWARD -i "${tun_device}" -j ACCEPT
}

tun_forward_enable() {
  tun_forward_disable

  echo 1 >/proc/sys/net/ipv4/ip_forward
  echo 2 >/proc/sys/net/ipv4/conf/default/rp_filter
  echo 2 >/proc/sys/net/ipv4/conf/all/rp_filter

  probe_tun_device || return 1
  tun_forward_iptables_rules "-I" && tun_ip_rules "add" &&
    log Info "tun hotspot support is enabled."
}

tun_forward_disable() {
  tun_ip_rules "del" >>/dev/null 2>&1
  tun_forward_iptables_rules "-D" >>/dev/null 2>&1
  log Warn "tun hotspot support is disabled."
}

start_proxy() {
  case "${PROXY_MODE}" in
  tproxy) ;;
  tun)
    if [ "${PROXY_HOTSPOT}" = "1" ]; then
      tun_forward_enable || return 1
    fi
    ;;
  *)
    log Error "invalid PROXY_MODE: ${PROXY_MODE}; expected tproxy or tun."
    return 1
    ;;
  esac
}

prepare_proxy() {
  case "${PROXY_MODE}" in
  tproxy)
    "${tproxy_path}" start
    ;;
  tun)
    "${tproxy_path}" guard && "${dns_path}" start
    ;;
  *)
    log Error "invalid PROXY_MODE: ${PROXY_MODE}; expected tproxy or tun."
    return 1
    ;;
  esac
}

case "$1" in
start)
  if ! prepare_proxy; then
    exit 1
  elif bin_pid=$(get_pid 2>/dev/null); then
    printf "%s" "${bin_pid}" >"${pid_file}"
    if ! wait_bin_ready; then
      log Error "${PROXY_MODE} endpoint did not become ready."
      exit 1
    elif ! start_proxy; then
      stop_service
      exit 1
    fi
  elif start_service; then
    if ! start_proxy; then
      log Error "failed to enable ${PROXY_MODE} proxy mode."
      stop_service
      exit 1
    fi
  else
    exit $?
  fi
  ;;
*)
  log Error "$0 $1 usage: $0 start"
  exit 2
  ;;
esac
